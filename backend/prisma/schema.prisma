generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String        @id @unique
  name          String
  category      String
  imageUrl      String?
  maxOrderLimit Int           @default(10)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relations
  allowedUnits  Unit[]
  description   Description?
  orderItems    OrderItem[]
}

model Unit {
  id                 String      @id @default(cuid())
  name               String
  price              Float
  discountPercentage Float       @default(0)
  
  product            Product     @relation(fields: [productId], references: [id])
  productId          String

  orderItems         OrderItem[]
  inventory          Inventory?
}

model Description {
  id                  String   @id @default(cuid())
  details             String?
  healthBenefits      String?
  shelfLife           String?
  returnPolicy        String?
  countryOfOrigin     String?
  seller              String?
  sellerFSSAI         String?
  product             Product  @relation(fields: [productId], references: [id])
  productId           String   @unique
}

enum UserRole {
  CUSTOMER
  ADMIN
  DELIVERY_PARTNER
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String?   @unique
  phone     String    @unique
  password  String
  role      UserRole  @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  addresses Address[]
  orders    Order[]
}

model Address {
  id          String   @id @default(cuid())
  addressLine String
  pincode     String
  city        String
  state       String
  isDefault   Boolean  @default(false)
  
  user        User     @relation(fields: [userId], references: [id])
  userId      String

  // Back relation
  orders      Order[]
}

model Order {
  id                String      @id @unique
  totalAmount       Float
  status            String      @default("PENDING")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  user              User        @relation(fields: [userId], references: [id])
  userId            String
  shippingAddress   Address     @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId String
  items             OrderItem[]
}

model OrderItem {
  id                String   @id @default(cuid())
  quantity          Int
  priceAtPurchase   Float

  // Relations
  order             Order    @relation(fields: [orderId], references: [id])
  orderId           String
  product           Product  @relation(fields: [productId], references: [id])
  productId         String
  unit              Unit     @relation(fields: [unitId], references: [id])
  unitId            String
}

model Inventory {
  id           String  @id @default(cuid())
  quantity     Int
  
  unit         Unit    @relation(fields: [unitId], references: [id])
  unitId       String  @unique
}

model IdSequence {
  id    String @id @default(cuid())
  name  String @unique
  value Int
}

model SeedingHistory {
  id       String   @id @default(cuid())
  seedName String   @unique
  runAt    DateTime @default(now())

  @@map("_SeedingHistory")
}